<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="Umbraco Nightly" value="https://www.myget.org/F/umbraconightly/api/v3/index.json" />
    <add key="Umbraco Prereleases" value="https://www.myget.org/F/umbracoprereleases/api/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="Umbraco Nightly">
      <!-- Engage 19 is only on the nightly feed for now. Move this mapping to Umbraco Prereleases once Engage 19 is published there. -->
      <package pattern="Umbraco.Engage" />
      <package pattern="Umbraco.Engage.*" />
    </packageSource>
    <packageSource key="Umbraco Prereleases">
      <package pattern="Umbraco.Automate" />
      <package pattern="Umbraco.Automate.*" />
      <!-- Umbraco.Licenses and Umbraco.Cms.* map to prereleases only: Umbraco.Licenses 19.0.0-beta was removed from MyGet, and the rc1 build needs CMS rc1, which is only on this feed. Remove both lines once CMS 19 is stable on nuget.org. -->
      <package pattern="Umbraco.Licenses" />
      <package pattern="Umbraco.Cms.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
