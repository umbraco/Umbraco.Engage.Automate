<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="Umbraco Nightly" value="https://www.myget.org/F/umbraconightly/api/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- Ignore mappings inherited from parent configs, such as a worktree inside another line's checkout. -->
    <clear />
    <packageSource key="Umbraco Nightly">
      <!-- Engage 19 is only on the nightly feed for now. Remove this source and mapping once Engage 19 is published to nuget.org. -->
      <package pattern="Umbraco.Engage" />
      <package pattern="Umbraco.Engage.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
